// Prisma schema for rolefetchr.
// Models mirror PLAN.md Phase 0. Run `npm run db:migrate` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for Migrate — migrations fail over Neon's pooler.
  directUrl = env("DIRECT_URL")
}

model Job {
  id          String   @id @default(cuid())
  source      Source
  // For source = MANUAL, the real platform name (e.g. "LinkedIn", "Jobgether").
  sourceLabel String?
  externalId  String // the job's original ID at its source
  title       String
  company     String
  description String   @db.Text
  location    String?
  remote      Boolean  @default(true)
  // How the role is worked. Sources are remote boards, so REMOTE is the
  // default; HYBRID/ONSITE mark roles tied to an office (detected at ingestion
  // or set explicitly via MCP) and get a distinct badge in the UI.
  workMode    WorkMode @default(REMOTE)
  salary      String?
  tags        String[]
  sourceUrl   String
  postedAt    DateTime
  fetchedAt   DateTime @default(now())
  // Bumped whenever the same posting arrives again (any dedupe hit) — a signal
  // the role is still open / being reposted. Null for jobs seen only once.
  lastSeenAt  DateTime?
  // True when the description couldn't be confirmed against the source (e.g. a
  // failed fetch_job_description attempt) — treat its content with caution.
  descriptionUnverified Boolean @default(false)

  // Derived at ingestion from the free-text fields (see lib/normalize.ts) so
  // the facet filters and universal search run on clean, indexed columns.
  // `location` itself stays untouched and is what the UI displays.
  region     String? // one of the REGIONS buckets, e.g. "Europe"
  country    String? // canonical English name when the location names one
  techs      String[] // curated tech vocabulary detected in title/tags/description
  companyKey String? // normalized company identity ("Huzzle Ltd" → "huzzle")
  // Soft-dedupe identity: normalized company + title. The same posting often
  // arrives under different URLs (reposts per city/country); jobs sharing a
  // fingerprint are surfaced as likely duplicates but never auto-merged.
  fingerprint String?

  // Tenant scope. null = the owner's real jobs. A DemoSpace.code value means the
  // job belongs to that read-but-also-interactive demo space, kept fully
  // isolated from the owner's data and from other spaces.
  demoCode    String?

  score  JobScore?
  action JobAction?

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([fetchedAt])
  @@index([demoCode])
  @@index([region])
  @@index([country])
  @@index([companyKey])
  @@index([fingerprint])
}

model JobScore {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score         Int // 0-100
  // False when the role requires something Valentina can't provide (relocation,
  // on-site, visa/residency/work-auth outside Spain) — a hard blocker.
  eligible      Boolean  @default(true)
  reasoning     String   @db.Text
  matchedSkills String[]
  gaps          String[]
  evaluatedAt   DateTime @default(now())
  // Who produced the score, e.g. "agent" (an external MCP agent). The app no
  // longer scores with an LLM — scoring is driven externally over MCP.
  model         String
}

model JobAction {
  id        String       @id @default(cuid())
  jobId     String       @unique
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ActionStatus // SAVED | APPLIED | NOT_INTERESTED | INTERVIEW | REJECTED
  notes     String?      @db.Text
  updatedAt DateTime     @updatedAt
}

// Singleton (id = 1). The scoring rubric + extra candidate context, editable at
// runtime over MCP. The app doesn't score itself; an external agent reads this
// as guidance (get_scoring_config) to score jobs consistently.
model ScoringConfig {
  id               Int      @id @default(1)
  rubric           String   @db.Text
  candidateContext String?  @db.Text
  cv               String?  @db.Text // the CV text jobs are scored against
  updatedAt        DateTime @updatedAt
}

// Raw job-alert emails forwarded by the Gmail Apps Script. Stored verbatim (no
// AI parsing in the app); an external agent fetches them over MCP
// (list_pending_emails), extracts the jobs itself, adds them (add_job), and
// marks the email processed (mark_email_processed).
model PendingEmail {
  id          String    @id @default(cuid())
  provider    String // e.g. "LinkedIn", "Jobgether"
  subject     String?
  html        String    @db.Text
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt])
}

model IngestionRun {
  id          String    @id @default(cuid())
  source      Source
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  jobsFetched Int       @default(0)
  jobsNew     Int       @default(0)
  error       String?
}

// A shareable, isolated demo of the whole app. `code` is the access key handed
// to a single recipient; anyone with it shares one space (changes are visible
// to all holders). Jobs in the space carry Job.demoCode = code. The space sees a
// full, interactive copy of the app scoped to its own data only — never the
// owner's data, never the MCP.
model DemoSpace {
  code      String   @id // the access key
  label     String // display name shown in the demo banner
  message   String?  @db.Text // optional override for the demo banner copy
  createdAt DateTime @default(now())

  // Usage tracking, so the owner can tell whether (and when) a recipient entered.
  firstUsedAt DateTime? // first successful code entry (null = never used)
  lastSeenAt  DateTime? // most recent activity in the space
  useCount    Int       @default(0) // number of code entries (new sessions/devices)
}

enum Source {
  REMOTEOK
  REMOTIVE
  WEWORKREMOTELY
  HACKERNEWS
  MANUAL
  HIMALAYAS
  JSEARCH
  EMAIL
  GETONBOARD
}

// Publishers muted from ingestion: accounts that aren't employers but bots
// reposting the same ad daily under fresh URLs without naming the real client.
// Matched on the normalized company identity (lib/normalize companyKey).
model MutedSource {
  key       String   @id // companyKey-normalized name
  label     String // the name as it was muted
  createdAt DateTime @default(now())
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ActionStatus {
  SAVED
  APPLIED
  NOT_INTERESTED
  INTERVIEW
  REJECTED
}

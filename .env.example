# Copy to .env and fill in real values. .env is gitignored.

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key for CV scoring (Phase 3).
ANTHROPIC_API_KEY=""

# Resend API key for the email digest (Phase 6).
RESEND_API_KEY=""

# Shared secret to authorize cron routes. Generate with: openssl rand -hex 32
CRON_SECRET=""

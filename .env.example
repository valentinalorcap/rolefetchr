# Copy to .env and fill in real values. .env is gitignored.

# Neon Postgres — POOLED connection string (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — DIRECT connection (no "-pooler"). Used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key for CV scoring (Phase 3).
ANTHROPIC_API_KEY=""

# Resend API key for the email digest (Phase 6).
RESEND_API_KEY=""

# Shared secret to authorize cron routes. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Bearer token for the MCP server (/api/mcp). Generate with: openssl rand -hex 32
MCP_TOKEN=""

# JSearch (Google for Jobs) via RapidAPI — covers LinkedIn/Indeed/Glassdoor.
JSEARCH_API_KEY=""

# Auth.js (NextAuth v5) — single-tenant login gate (Phase 8).
# Session-cookie signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=""
# GitHub OAuth app credentials (Settings → Developer settings → OAuth Apps).
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Comma-separated allowlist of emails permitted to sign in (your GitHub email).
ALLOWED_EMAILS="you@example.com"
